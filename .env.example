# Salin ke .env untuk pengembangan lokal. Di produksi, .env ada di folder aplikasi di server.
NODE_ENV=development
PORT=3210
APP_URL=http://localhost:5173

# Database dev & test (wainbox_dev / wainbox_test di server, lewat tunnel: ssh -N -L 3307:127.0.0.1:3306 <host>)
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/wainbox_dev
DATABASE_URL_TEST=mysql://USER:PASSWORD@127.0.0.1:3307/wainbox_test

# 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=
SESSION_SECRET=

STORAGE_DIR=./storage
GRAPH_API_VERSION=v26.0
TZ=Asia/Jakarta

# Opsional
# MEDIA_RETENTION_DAYS=365
# MAX_UPLOAD_MB=100
# API_RATE_LIMIT_PER_MIN=60
# SEND_READ_RECEIPTS=true
# LOG_LEVEL=info
